# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Telegram Channel for movie uploads (e.g. @moviemanchannel)
TELEGRAM_CHANNEL_ID=

# Telethon MTProto credentials for up to 2GB uploads
# Get from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELETHON_SESSION=telethon.session

# Max upload size in MB (50 for standard bot, 2000 for Telethon)
MAX_UPLOAD_SIZE_MB=2000

# Mega Account (optional — anonymous works for public links but has quota limits)
MEGA_EMAIL=
MEGA_PASSWORD=

# MMSubChannel
MMSUBCHANNEL_BASE_URL=https://mmsubchannel.com

# Auto-scrape interval in minutes (0 = disabled, on-demand only)
SCRAPE_INTERVAL_MINUTES=0

# Workspace
WORKSPACE_DIR=./workspace

# Processing
MAX_CONCURRENT_JOBS=1

# Logging
LOG_LEVEL=INFO

# Playwright browser (chromium, firefox, webkit)
BROWSER_TYPE=chromium
BROWSER_HEADLESS=true
